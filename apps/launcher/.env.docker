# ── Launcher App — Environment Variables ─────────────

# ── Silo Connection (Widget Deployment Target) ──────
SILO_ENDPOINT=silo
SILO_PORT=9001
SILO_USE_SSL=false
SILO_ACCESS_KEY=silo-admin
SILO_SECRET_KEY=                              # populated by installer


# ── Widget Build Targets ───────────────────────────
API_URL_PRODUCTION=                           # populated by installer
CDN_URL_PRODUCTION=                           # populated by installer
